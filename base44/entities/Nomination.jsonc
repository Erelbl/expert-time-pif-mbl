{
  "name": "Nomination",
  "type": "object",
  "properties": {
    "nominee_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e2\u05de\u05d3"
    },
    "nominee_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05d5\u05e2\u05de\u05d3"
    },
    "nominator_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05de\u05dc\u05d9\u05e5"
    },
    "expertise_area": {
      "type": "string",
      "description": "\u05ea\u05d7\u05d5\u05dd \u05de\u05d5\u05de\u05d7\u05d9\u05d5\u05ea"
    },
    "reason": {
      "type": "string",
      "description": "\u05e1\u05d9\u05d1\u05ea \u05d4\u05d4\u05de\u05dc\u05e6\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewed",
        "accepted",
        "declined"
      ],
      "default": "new"
    }
  },
  "required": [
    "nominee_name",
    "nominator_name",
    "expertise_area"
  ]
}